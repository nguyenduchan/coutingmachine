(footprint "SW_Push_6mm_SMD"
	(version 20240108)
	(generator "route_4layer.py")
	(layer "F.Cu")
	(descr "Tactile 6x6 mm SMT 4-pin (same pin map as THT)")
	(tags "switch tactile SMT")
	(attr smd)
	(fp_rect (start -4.5 -3.5) (end 4.5 3.5)
		(stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
	(fp_rect (start -3.0 -3.0) (end 3.0 3.0)
		(stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
	(fp_circle (center 0 0) (end 1.2 0)
		(stroke (width 0.12) (type solid)) (fill none) (layer "F.SilkS"))
	(pad "1" smd roundrect (at -3.25 -2.25) (size 1.5 1.2)
		(layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
	(pad "2" smd roundrect (at 3.25 -2.25) (size 1.5 1.2)
		(layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
	(pad "3" smd roundrect (at 3.25 2.25) (size 1.5 1.2)
		(layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
	(pad "4" smd roundrect (at -3.25 2.25) (size 1.5 1.2)
		(layers "F.Cu" "F.Paste" "F.Mask") (roundrect_rratio 0.2))
	(model "${KICAD10_3DMODEL_DIR}/Button_Switch_SMD.3dshapes/SW_SPST_PTS645.step"
		(offset (xyz 0 0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0)))
)
