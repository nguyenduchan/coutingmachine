        a("\t\t\t(size 2.0 2.0)")
        a("\t\t\t(drill 1.0)")
        a('\t\t\t(layers "*.Cu" "*.Mask")')
        a(f'\t\t\t(net {net_i} "{net_n}")')
        a(f'\t\t\t(uuid "{uid()}")')
        a("\t\t)")
    a("\t)")

    # --- U3 TMC2209 BOTTOM (right of power column, clear of J1 via farm) ---
    tx, ty = ox + 100.0, oy + 95.0
    t_hx = TMC_ROW / 2
    t_y0 = -3.5 * PITCH
    a('\t(footprint "ESP32_Carrier:TMC2209_StepStick"')
    a('\t\t(layer "B.Cu")')
