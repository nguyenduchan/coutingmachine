    (16, "VIN", "power_in"),
    (17, "GND", "passive"),
    (18, "IO13", "bidirectional"),
    (19, "IO12", "bidirectional"),
    (20, "IO14", "bidirectional"),
    (21, "IO27", "bidirectional"),
    (22, "IO26", "bidirectional"),
    (23, "IO25", "bidirectional"),
    (24, "IO33", "bidirectional"),
    (25, "IO32", "bidirectional"),
    (26, "IO35", "input"),
    (27, "IO34", "input"),
    (28, "VN", "input"),
    (29, "VP", "input"),
    (30, "EN", "bidirectional"),
]

PITCH = 2.54
ROW_SPACING = 25.4
PAD_SIZE = 1.7
PAD_DRILL = 1.0

# Mini560 ~29-30 x 18 mm stamp-hole module (VIN+/VIN-/VOUT+/VOUT-)
# Pad centers: short-end headers, pitch 2.54, span ~25.4 mm (verify on your module).
MINI560_W = 30.0
MINI560_H = 18.0
MINI560_PAD_SPAN_X = 25.4  # left<->right pad centers
MINI560_PAD_SPAN_Y = 2.54  # VIN<->GND / VOUT<->GND

# KF301-5.0 / Phoenix PT 1.5 / 2-pin screw terminal, pitch 5.0 mm
TB_PITCH = 5.0

# Bottom-side modules (B.Cu, rot 180)
BOTTOM_ROT = 180

# BTT-style TMC2209 stepstick ~15.24 x 20.32 mm, dual 1x8 @ 2.54, row 15.24
TMC_W = 20.4
TMC_H = 20.4
TMC_ROW = 15.24  # pad-column spacing

# Top-side external connectors (F.Cu)
# J2 = NEMA17 coil phases from TMC2209 (A2 A1 B1 B2)
MOTOR_HEADER = [
    ("1", "A2", 11),
    ("2", "A1", 12),
    ("3", "B1", 13),
    ("4", "B2", 14),
]
SENSOR_HEADER = [
    ("1", "GND", 2),
    ("2", "3V3", 4),
    ("3", "IO32", 7),
    ("4", "IO33", 8),
    ("5", "IO34", 9),
    ("6", "IO35", 10),
]

# Via farm for +12V layer transfer â‰¥3A (0.6 mm drill x 6 â‰ˆ comfortable for 3A)
VIA12_DRILL = 0.6
VIA12_DIA = 1.1
VIA12_COUNT_X = 3
VIA12_COUNT_Y = 2
VIA12_PITCH = 1.8

# PC817 8-ch opto isolation module ~100 x 28 mm (thegioimodule / Shopee)
# Dual 1x10 @ 2.54 mm, row spacing 20.32 mm — VERIFY on real board before fab
PC817_W = 100.0
PC817_H = 28.0
PC817_ROW = 20.32
# OUT(MCU) <-> ESP32 GPIO map (index 0 = OUT1)
OPTO_GPIO = [
