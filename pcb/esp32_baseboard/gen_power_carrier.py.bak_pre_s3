#!/usr/bin/env python3
"""Generate Mini560 + TMC2209 + screw-terminal libs and carrier schematic/PCB.

Power path (ready-made modules on BOTTOM of carrier PCB):
  12V-3A PSU --screw terminal J1--> +12V/GND
       --> Mini560 (U2) buck 12V->5V -> ESP32 VIN
       --> TMC2209 (U3) VM (motor 12V) + VIO from ESP32 3V3
TOP: J2 NEMA17 phases, J3 sensors.
"""

from __future__ import annotations

import json
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parent
LIB = ROOT / "libraries"
PRETTY = LIB / "ESP32_Carrier.pretty"

# --- ESP32 DevKit V1 30-pin (same as gen_esp32_30pin_libs.py) ---
