	(pad "1" thru_hole circle (at -3.25 -2.25) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
	(pad "2" thru_hole circle (at 3.25 -2.25) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
	(pad "3" thru_hole circle (at 3.25 2.25) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
	(pad "4" thru_hole circle (at -3.25 2.25) (size 1.5 1.5) (drill 0.9) (layers "*.Cu" "*.Mask"))
	(model "${KICAD10_3DMODEL_DIR}/Button_Switch_THT.3dshapes/SW_PUSH_6mm.step"
