(footprint "L_SMD_6x6"
	(version 20240108)
	(generator "gen_compact_carrier.py")
	(layer "F.Cu")
	(descr "Power inductor ~6x6mm 10uH")
	(attr smd)
	(fp_rect (start -3.5 -3.5) (end 3.5 3.5)
		(stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))
	(pad "1" smd rect (at -2.25 0) (size 1.7 5.7) (layers "F.Cu" "F.Paste" "F.Mask"))
	(pad "2" smd rect (at 2.25 0) (size 1.7 5.7) (layers "F.Cu" "F.Paste" "F.Mask"))
	(model "${KICAD10_3DMODEL_DIR}/Inductor_SMD.3dshapes/L_Sunlord_SWPA6040S.step"
		(offset (xyz 0 0 0))
		(scale (xyz 1 1 1))
		(rotate (xyz 0 0 0)))
)
