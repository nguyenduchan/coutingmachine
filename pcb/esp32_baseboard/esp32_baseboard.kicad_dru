(version 1)

# JLCPCB house floor: copper may run close to Edge.Cuts (0.30 mm).
# Via–pad clearance stays 1.00 mm (A11).

(rule "House min track (Default)"
	(constraint track_width (min 0.25mm))
)

(rule "JLC hole to hole"
	(constraint hole_to_hole (min 0.45mm))
)

(rule "JLC copper to hole"
	(constraint hole_clearance (min 0.20mm))
)

(rule "JLC courtyard"
	(constraint courtyard_clearance (min 0.30mm))
)

(rule "Copper to board edge JLC house"
	(constraint edge_clearance (min 0.30mm))
)

(rule "Via copper to component pad 1mm"
	(constraint clearance (min 1.00mm))
	(condition "A.Type == 'Via' && B.Type == 'Pad'")
)

(rule "JLC silk to pad"
	(constraint silk_clearance (min 0.15mm))
)
