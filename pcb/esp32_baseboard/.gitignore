# KiCad lock files (created while a project is open, never useful to track)
~*.lck
*.lck

# KiCad local user state / plot-viewer prefs (machine-specific)
*.kicad_prl
fp-info-cache
*-backups/
\#auto_saved_files\#

# KiCad/editor backup & autosave
*.bak
*.bak_*
*-bak/
_autosave-*

# Python bytecode (also covered by root .gitignore)
__pycache__/
*.py[cod]

# Build/route/verify logs and one-off debug dumps regenerated by the scripts
# in this folder (loop_check.sh, verify_all.py, route_freerouting.py, ...)
*.log
*.err
drc_report.txt
drc_now.txt
_open_test_drc.txt
_route_out*.txt
_route235b.txt
_all.txt
_bad.txt
_l298n_pcb.txt
_l298n_sch.txt
_cluster_balance.json

# Generated preview/export/routing-tool output directories
out_preview/
out_freerouting/
modules/out_freerouting/
_595mod_scrape/

# Scratch snapshots / one-off test projects (superseded, not the fab source)
_ok_220x160.kicad_pcb
_test_zone_api.kicad_pro
_test_zone_api.kicad_prl

# Agent session temps
_dist*.py
_patch_hdr*.py
_tmp_*.py
_tmp_*.txt

# Screenshot / ad-hoc preview (not BOM/fab SoT)
baseboard_current.png

# VS Code Local History (its own .git, not part of this repo's history)
.history/

# Third-party binary tool -- large (~64MB) and independently downloadable,
# not project source. See README for where to fetch it.
tools/*.jar
